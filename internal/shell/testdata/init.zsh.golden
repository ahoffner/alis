# Generated by `alis init zsh`. Do not edit; change your packs instead.
if (( ${+__alis_names} )); then
  for __alis_n in $__alis_names; do unalias $__alis_n 2>/dev/null; unfunction $__alis_n 2>/dev/null; done
  unset __alis_n
fi
typeset -ga __alis_names
__alis_names=(fn gc q scr usealias)
export ALIS_LIB='/lib/alis.sh'
alias q='echo "it'\''s" $HOME \"x\" \\ done'
eval 'unalias fn 2>/dev/null
function fn {
printf '\''%s|'\'' "$@"
echo
}' 2>/dev/null
eval 'unalias gc 2>/dev/null
function gc {
echo mine
}' 2>/dev/null
eval 'unalias scr 2>/dev/null
function scr { '\''$PACKDIR/bin/scr'\'' "$@"; }' 2>/dev/null
eval 'unalias usealias 2>/dev/null
function usealias {
q
}' 2>/dev/null
eval 'unalias alis 2>/dev/null
function alis {
  if (( $# == 0 )); then
    local __alis_cmd
    __alis_cmd="$(command alis pick)" || return
    [[ -n $__alis_cmd ]] && print -z -- "$__alis_cmd"
    return 0
  fi
  command alis "$@" || return
  case "$1" in
    pack|enable|disable|local|update) eval "$(command alis init zsh)" ;;
  esac
}' 2>/dev/null
